{
  "name": "pipeline-trace-desktop",
  "productName": "pipeline-trace",
  "version": "0.1.0",
  "private": true,
  "description": "Водопад длительности GitLab-пайплайнов",
  "author": { "name": "pipeline-trace", "email": "noreply@pipeline-trace.invalid" },
  "type": "module",
  "main": "app/main.mjs",
  "scripts": {
    "sync-core": "node scripts/sync-core.mjs",
    "dev": "npm run sync-core && electron .",
    "dist": "npm run sync-core && electron-builder --publish never",
    "test": "npm run sync-core && node --test \"test/*.test.mjs\""
  },
  "devDependencies": {
    "electron": "44.4.5",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "dev.pipeline-trace.desktop",
    "productName": "pipeline-trace",
    "files": ["app/**", "package.json"],
    "directories": { "output": "dist" },
    "mac": {
      "identity": null,
      "category": "public.app-category.developer-tools",
      "target": [{ "target": "dmg", "arch": ["arm64", "x64"] }, { "target": "zip", "arch": ["arm64", "x64"] }]
    },
    "win": { "target": [{ "target": "nsis", "arch": ["x64"] }, { "target": "zip", "arch": ["x64"] }] },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true },
    "linux": {
      "category": "Development",
      "maintainer": "pipeline-trace <noreply@pipeline-trace.invalid>",
      "target": [{ "target": "AppImage", "arch": ["x64"] }, { "target": "deb", "arch": ["x64"] }]
    }
  }
}
