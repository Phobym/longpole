{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "form",
  "description": "Единственное окно приложения",
  "windows": ["form"],
  "permissions": [
    "allow-hosts",
    "allow-set-token",
    "allow-remove-token",
    "allow-history",
    "allow-remove-history",
    "allow-clear-history",
    "allow-projects",
    "allow-branches",
    "allow-pipelines",
    "allow-workflows",
    "allow-host-provider",
    "allow-build",
    "allow-report",
    "allow-find-report",
    "allow-set-current-report",
    "allow-add-project",
    "allow-remove-project",
    "allow-saved-projects",
